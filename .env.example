# ===== 服务配置 =====
# 监听端口
PORT=3000
# JWT 签名密钥（生产环境务必改为长随机串）
JWT_SECRET=change-me-to-a-long-random-string
# 数据库文件路径（相对或绝对）
DB_PATH=./data/app.db

# ===== 积分 / 人民币兑换 =====
# 1 元人民币可兑换的积分数量
EXCHANGE_RATE=10

# ===== DeepSeek 智能体（可选）=====
# 不填则自动使用“学科模板兜底”，网站仍可完整离线运行与演示。
# 填入后平台将调用 DeepSeek 生成更高质量的知识点讲解、思路与自适应讲解。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
